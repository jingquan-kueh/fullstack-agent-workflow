# Copy to .env and fill in. Never commit .env.
# Validated at startup by backend/src/env.ts.

# Local Postgres from docker-compose.yml (`npm run db:up`)
DATABASE_URL=postgres://app:app@localhost:5432/app
# Host port for that container (default 5432). If you change it, change DATABASE_URL to match.
DB_PORT=

# API port; the Vite dev server proxies /api to it. Defaults to 3000.
PORT=
